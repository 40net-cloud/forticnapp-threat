# Copy to terraform.tfvars and adjust. Used by main.tf

# --- Required ---
prefix   = "multi-cve"           # Name prefix added to each resource
region   = "eu-west-1"           # AWS region
key_name = "my-ec2-keypair"      # Existing EC2 key pair (SSH login user: ubuntu or admin, depending on os_image)

# --- Terraform state: "local" (default) or "s3" ---
# Terraform cannot read variables in a backend block, so run scripts/configure-state-backend.sh
# after changing these, then `terraform init -reconfigure` (or `-migrate-state`).
# For s3, create the bucket once with scripts/create-tfstate-bucket.sh.
state_backend = "local"
# state_bucket = ""                               # Empty = multi-cve-tfstate-<account>-<region>
# state_key    = "vulnerable-vm/terraform.tfstate"

# --- Access ---
# Restrict SSH and the Brotli demo port to your own public IP, e.g. "203.0.113.10/32", "*", ...
admin_source_cidr = "*"

# --- Scenario selection: which vulnerabilities this ONE host gets ---
# All three by default -> a single host carrying every vulnerability the repo demos:
#   php2shell       PHP2Shell (CVE-2026-109618 / CVE-2026-109619)
#   broccoli2shell  Node2Shell / Brotli (CVE-2026-111497)
#   cve-2026-119618 Apache mod_http2 RCE (CVE-2026-119618)
scenarios = ["php2shell", "broccoli2shell", "cve-2026-119618"]

# --- OS image: "ubuntu-26.04" (PHP 8.5, Node 22, Apache 2.4.66) or "debian-13" (PHP 8.4, Node 20, Apache 2.4.69) ---
os_image = "debian-13"

# Optional: override or extend the list of selectable images (replaces the built-in list entirely).
# See the os_images variable in main.tf for the full object shape (all pins per image).
# os_images = [ ... ]

# --- Pins (scenario-specific; defaults per image in main.tf, verified against the archives 2026-11-13) ---
# Optional overrides (leave commented to use the image defaults):
# php_version             = "8.4.26-1~deb13u1"      # vulnerable range for CVE-2026-109618/109619
# php_snapshot_timestamp  = "20261010T000000Z"       # Debian only
# node_version            = "20.19.2+dfsg-1+deb13u2"
# brotli_version          = "1.1.0-2+b7"             # must be below the distro fix
# node_snapshot_timestamp = "20261101T000000Z"
# apache_version          = "2.4.69-1~deb13u1"       # must stay <= 2.4.70 (CVE-2026-119618)
# apache_snapshot_timestamp = "20261111T000312Z"
demo_port = 3000   # Reachable from admin_source_cidr only (broccoli2shell scenario)

# --- FortiCNAPP agent ---
install_forticnapp_agent = false
# Required when install_forticnapp_agent = true (letters, digits, '-' and '_' only).
# Prefer passing it via the environment: export TF_VAR_forticnapp_access_token=<token>
# forticnapp_access_token = ""
forticnapp_server_url = "https://api.fra.lacework.net"   # Empty string = auto-discover

# --- Network and instance ---
vpc           = "172.16.140.0/24"
subnet        = "172.16.140.0/25"
instance_type = "t3.small"      # Use e.g. "t4g.small" together with arch = "arm64"
arch          = "x86_64"        # "x86_64" or "arm64"; must match instance_type

tags = {
  project = "multi-cve"
}
